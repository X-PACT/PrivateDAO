# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Solana RPC (QuickNode)
QUICKNODE_RPC_URL=https://your-endpoint.quiknode.pro/your-key/

# Jupiter Swap API
JUPITER_SWAP_API=https://lite-api.jup.ag/swap/v1
# JUPITER_API_KEY=optional_paid_or_developer_key
JUPITER_BASE_URL=https://api.jup.ag
JUPITER_ORDER_ENDPOINT=https://api.jup.ag/swap/v2/order
JUPITER_EXECUTE_ENDPOINT=https://api.jup.ag/swap/v2/execute
JUPITER_BUILD_ENDPOINT=https://api.jup.ag/swap/v2/build
JUPITER_SUBMIT_ENDPOINT=https://api.jup.ag/tx/v1/submit
JUPITER_ENABLE_V2_ORDER=false

# Market data and fast execution providers
SOLANA_TRACKER_API_KEY=
SOLANA_TRACKER_BASE_URL=https://data.solanatracker.io
DEXSCREENER_BASE_URL=https://api.dexscreener.com/latest/dex
HELIUS_API_KEY=
HELIUS_RPC_URL=
ENABLE_JITO_FAST_SEND=false
JITO_SEND_TRANSACTION_URL=https://mainnet.block-engine.jito.wtf/api/v1/transactions
JITO_AUTH_UUID=
JITO_STRICT=false

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key

# PDAO Token (default trading pair)
PDAO_MINT=9isGuumtaqvJeJeyLF44fvfskk2cv5mYsopexMBfpump

# Creator wallet for PnL-based subscription fees
CREATOR_WALLET=2BJ4ezxqV9YJXc38D9duKBkdn4su4jE1beKUHwH663sL

# Mainnet execution gates. Keep both true only after security checks pass.
TRADING_BOT_EXECUTE_SWAPS=false
ENABLE_MAINNET_TRADING=false
DEFAULT_SLIPPAGE_BPS=1200
MAX_SLIPPAGE_BPS=5000
MIN_TRADE_USD=15
ALLOW_ANY_TOKEN=true
USER_DEFINED_TRADE_LIMIT=true
MAX_TRADE_SOL=1
MAX_TRADE_USDC=1000
MIN_SOL_GAS_RESERVE=0.003

# PnL fees
PDAO_STANDARD_FEE_PERCENT=5
MEME_STANDARD_FEE_PERCENT=8
ZK_PRIVATE_FEE_PERCENT=15

# Fee Settlement Cron (cron syntax, default = every minute)
FEE_SETTLEMENT_CRON=*/1 * * * *
MIN_SETTLEMENT_SOL=0.002

# PrivateDAO Proof API (api.privatedao.org) — bot only calls this, never
# implements ZK/cryptography logic itself
PRIVATEDAO_API_URL=https://api.privatedao.org
PRIVATEDAO_API_KEY=your_api_key_if_required

# Wallet Encryption (32 bytes = 64 hex chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=your_64_char_hex_key
PDAO_TRADING_DISCOUNT_LABEL=50% lower service fee on PDAO trades
